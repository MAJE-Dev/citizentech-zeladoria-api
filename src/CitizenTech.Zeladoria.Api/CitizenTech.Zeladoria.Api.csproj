<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CitizenTech.Zeladoria.Api</RootNamespace>
    <!-- A string de conexão fica fora do ZIP, em user-secrets (ver README). -->
    <UserSecretsId>fiap-gs-zeladoria-api-2026-2</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Um banco basta: SQL Server. Provider da mesma geração do runtime (.NET 10 / EF Core 10). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.15" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="11.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="equipe.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
